# =============================================================================
#  OutlastVR Walrider - .gitignore
#  What must NOT be committed: everything a build or an editor generates.
#  What MUST be committed: src/, tests/, docs/ (incl. docs/archive/), launcher/
#  sources, runtime/outlastvr.ini, scripts/build.bat, third_party/, LICENSE,
#  README.md.
# =============================================================================

# ---- Build output (fully generated by scripts/build.bat) --------------------
# 18 .obj + d3d9.dll + .exp + .lib + .map, about 9 MB, rebuilt by any build.
builds/

# ---- Compiler / linker artefacts -------------------------------------------
# Also covers a build that lands outside builds/ (e.g. an ad-hoc cl.exe run).
*.obj
*.exp
*.lib
*.map
*.pdb
*.ilk
*.idb

# ---- Launcher output --------------------------------------------------------
# build_launcher.cmd writes the exe; --preview writes any png name; a failure
# writes the devtool error text.
launcher/Outlast1VR.exe
launcher/preview_*.png
launcher/Outlast1VR_devtool_error.txt

# ---- Binaries ---------------------------------------------------------------
# d3d9.dll is build output (covered by builds/). The Khronos OpenXR loader IS
# distributed with the mod and lives with the other vendored dependencies, so it must
# stay versioned - hence the explicit path rather than a bare glob.
*.exe
*.dll
!third_party/openxr/openxr_loader.dll

# ---- Release staging (regenerated by scripts/build.bat from the real sources) ----------------
# The license texts and the loader are copied into runtime\ so a release folder is
# self-contained. Their single sources are LICENSE, third_party/third-party-notices.txt and
# third_party/openxr/openxr_loader.dll - those are the ones that are versioned.
runtime/LICENSE.txt
runtime/THIRD-PARTY NOTICES.txt
runtime/openxr_loader.dll

# ---- Python (the test suites are Python) -----------------------------------
__pycache__/
*.pyc
.pytest_cache/

# ---- Editors / IDEs --------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user
*.code-workspace
compile_commands.json

# ---- Local junk ------------------------------------------------------------
# The mod's own logs live in %LOCALAPPDATA%\OutlastVR and are named *.txt, not
# *.log (OutlastVR_Log.txt, Launcher_Log.txt); the explicit names below catch a
# log copied into the tree when someone reports a bug.
OutlastVR_Log.txt
Launcher_Log.txt
*.log
*.bak
*.orig
*.rej
*.tmp
.DS_Store
Thumbs.db
